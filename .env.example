# Copy to .env and adjust for your environment.
# .env is gitignored; never commit real secrets.

# --- App ---
APP_ENV=dev                    # dev | staging | prod
APP_ADDR=:8080
LOG_LEVEL=info                 # debug | info | warn | error
PUBLIC_BASE_URL=http://localhost:3000

# --- Database (Postgres) ---
DATABASE_URL=postgres://tickets:tickets@localhost:5432/tickets?sslmode=disable

# --- Object storage (Garage, S3-compatible; same in dev and prod) ---
# Dev values match the garage service in docker-compose.yml.
STORAGE_ENDPOINT=http://localhost:3900
STORAGE_REGION=us-east-1       # must equal s3_region in garage.toml
STORAGE_BUCKET=tickets
STORAGE_ACCESS_KEY=GKdev0000000000000000000
STORAGE_SECRET_KEY=devsecretdevsecretdevsecretdevsecret
STORAGE_USE_PATH_STYLE=true    # Garage serves path-style without a root_domain

# --- Mail (Amazon SES, dev and prod) ---
# All transactional email goes through SES; no SMTP fallback.
#
# MVP testing arrangement: reuse the AWS credentials and verified sender
# domain from the sibling tickets-psyrock-com project, which already has SES
# configured to send from psychedelic-rock.com. Set AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, and AWS_REGION to those values; set MAIL_FROM to a
# verified address on that domain.
#
# When tickets-general gets its own production AWS account, swap these for
# its dedicated IAM user / verified sender (Phase 11).
MAIL_FROM=noreply@psychedelic-rock.com
MAIL_FROM_DISPLAY_NAME=tickets-general
MAIL_UNSUBSCRIBE_ADDRESS=unsubscribe@psychedelic-rock.com
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=

# --- Sessions ---
# 32 random bytes, base64-encoded. Used to sign view tokens / QR tokens (Phase 5).
# Generate: openssl rand -base64 32
TOKEN_SIGNING_KEY=replace-me-with-32-random-bytes-base64

# --- PayPal (Phase 6) ---
PAYPAL_ENV=sandbox             # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
